# ============================================
# Wechat Agent 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入实际值

# 企业微信配置
WECOM_CORP_ID=your_corp_id
WECOM_SECRET=your_wecom_secret
WECOM_AGENT_ID=1000000

# 应用回调配置
APP_TOKEN=your_app_token
APP_AES_KEY=your_app_aes_key

# 联系人回调配置
CONTACT_TOKEN=your_contact_token
CONTACT_AES_KEY=your_contact_aes_key

# 客服配置
KF_OPEN_KFID=your_kf_id

# LLM 配置 (OpenAI 兼容 API)
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4

# 多模态 LLM 配置
MLLM_API_KEY=your_mllm_api_key
MLLM_BASE_URL=https://api.openai.com/v1
MLLM_MODEL_NAME=gpt-4-vision

# 服务器配置
SERVER_IP=your_server_ip

# 默认员工配置
DEFAULT_EMPLOYEE_USERID=your_default_user_id
SECOND_EMPLOYEE_USERID=your_second_user_id

# 其他配置
TOOL_PERSON_EXTERNAL_USERID=your_tool_person_external_userid
H5_BASE_URL=https://your-h5-domain.com